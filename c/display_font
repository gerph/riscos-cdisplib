#include "cdisplib_internal.h"

#define CDISPLIB_DEFAULT_FONT_BG 0xDDDDDD10

/*******************************************************************
 Function:      cdisplib_measure_text
 Description:   Measure the width of a string in OS units
 Parameters:    display = display supplying font context
                text = text to measure
 Returns:       measured width
 ******************************************************************/
int cdisplib_measure_text(CDispDisplay *display, const char *text)
{
    int width;

    if (text == NULL || *text == '\0')
    {
        return 0;
    }

    if (display != NULL && display->font_metrics.handle != -1)
    {
        _kernel_oserror *error;
        int x_value;

        x_value = 0;
        error = _swix(Font_ScanString,
                      _IN(0) | _IN(1) | _IN(2) | _IN(3) | _IN(4) | _OUT(3),
                      display->font_metrics.handle,
                      text,
                      1 << 8,
                      1000000000,
                      1000000000,
                      &x_value);
        if (error == NULL)
        {
            return x_value / 400;
        }
    }

    width = (int) strlen(text);
    if (display != NULL && display->font_metrics.name == NULL)
    {
        return width * 16;
    }
    if (display != NULL && display->font_metrics.name != NULL)
    {
        return 1;
    }

    return width;
}

/*******************************************************************
 Function:      cdisplib_validate_font
 Description:   Refresh cached font metrics
 Parameters:    display = display to update
 Returns:       none
 ******************************************************************/
void cdisplib_validate_font(CDispDisplay *display)
{
    font_info info;
    os_error *error;
    int old_line_height;
    int old_max_char_width;
    int old_left_margin;
    int old_baseline_offset;

    if (display == NULL)
    {
        return;
    }

    old_line_height = display->font_metrics.line_height;
    old_max_char_width = display->font_metrics.max_char_width;
    old_left_margin = display->font_metrics.left_margin;
    old_baseline_offset = display->font_metrics.baseline_offset;

    if (display->font_metrics.handle != -1)
    {
        font_lose(display->font_metrics.handle);
        display->font_metrics.handle = -1;
    }

    if (display->font_metrics.name == NULL || *display->font_metrics.name == '\0')
    {
        display->font_metrics.line_height = 36;
        display->font_metrics.max_char_width = 16;
        display->font_metrics.left_margin = 0;
        display->font_metrics.baseline_offset = 0;
        return;
    }

    error = font_find(display->font_metrics.name,
                      display->font_metrics.size_16ths,
                      display->font_metrics.size_16ths,
                      0,
                      0,
                      &display->font_metrics.handle);
    if (error != NULL)
    {
        display->font_metrics.handle = -1;
        display->font_metrics.line_height = old_line_height;
        display->font_metrics.max_char_width = old_max_char_width;
        display->font_metrics.left_margin = old_left_margin;
        display->font_metrics.baseline_offset = old_baseline_offset;
        return;
    }

    error = font_readinfo(display->font_metrics.handle, &info);
    if (error != NULL)
    {
        display->font_metrics.line_height = 36;
        display->font_metrics.max_char_width = 16;
        display->font_metrics.left_margin = 0;
        display->font_metrics.baseline_offset = 0;
        return;
    }

    display->font_metrics.line_height = (info.maxy - info.miny + 3) & ~1;
    display->font_metrics.max_char_width = info.maxx - info.minx;
    display->font_metrics.left_margin = -info.minx;
    display->font_metrics.baseline_offset = -info.miny;
}

/*******************************************************************
 Function:      cdisplib_display_set_font
 Description:   Change the font used by a display
 Parameters:    display = display to update
                font_name = font name, or NULL/empty for system font
                size_points = font size in points
 Returns:       none
 ******************************************************************/
void cdisplib_display_set_font(CDispDisplay *display, const char *font_name, int size_points)
{
    CDispLine *line;

    if (display == NULL)
    {
        return;
    }

    cdisplib_force_redraw(display,
                          0,
                          -display->line_count * display->font_metrics.line_height - CDISPLIB_WINDOW_BOTTOM_MARGIN,
                          display->widest_width + 12 + display->font_metrics.left_margin,
                          0);

    free(display->font_metrics.name);
    if (font_name == NULL || *font_name == '\0')
    {
        display->font_metrics.name = NULL;
    }
    else
    {
        display->font_metrics.name = cdisplib_strdup(font_name);
        if (size_points != -1)
        {
            display->font_metrics.size_16ths = size_points * 16;
        }
    }

    cdisplib_validate_font(display);

    display->widest_width = display->min_width_chars * display->font_metrics.max_char_width;
    line = display->head;
    while (line != NULL)
    {
        CDispTextRun *run;
        int width;

        run = line->runs;
        width = 0;
        while (run != NULL)
        {
            run->width = cdisplib_measure_text(display, run->text);
            width += run->width;
            run = run->next;
        }
        if (width > display->widest_width)
        {
            display->widest_width = width;
        }
        line = line->next;
    }

    cdisplib_force_redraw(display,
                          0,
                          -display->line_count * display->font_metrics.line_height - CDISPLIB_WINDOW_BOTTOM_MARGIN,
                          display->widest_width + 12 + display->font_metrics.left_margin,
                          0);
    cdisplib_display_resize(display);
}

/*******************************************************************
 Function:      cdisplib_set_colour
 Description:   Select a graphics colour
 Parameters:    display = display supplying private palette
                colour = colour value
 Returns:       none
 ******************************************************************/
void cdisplib_set_colour(const CDispDisplay *display, int colour)
{
    int low;

    low = colour & 0xFF;
    if (low < 0x10)
    {
        _swix(Wimp_SetColour, _IN(0), colour);
        return;
    }
    if (low == 0x10)
    {
        _swix(ColourTrans_SetGCOL, _IN(0) | _IN(3) | _IN(4), colour, 0x100, 0);
        return;
    }
    if (low == 0x11 && display != NULL)
    {
        int entry;

        entry = colour >> 8;
        if (entry >= 0 && entry < display->private_palette.count)
        {
            cdisplib_set_colour(display, display->private_palette.entries[entry]);
        }
    }
}

/*******************************************************************
 Function:      cdisplib_resolve_font_palette_entry
 Description:   Resolve a display colour to a palette entry for font output
 Parameters:    display = display supplying palette/default state
                colour = requested colour value
                fallback_colour = default colour to use for unresolved private refs
                allow_default_fallback = non-zero to convert -1 into fallback/default
 Returns:       palette entry suitable for ColourTrans_SetFontColours
 ******************************************************************/
int cdisplib_resolve_font_palette_entry(const CDispDisplay *display,
                                        int colour,
                                        int fallback_colour,
                                        int allow_default_fallback)
{
    int entry;

    if (display == NULL)
    {
        return colour;
    }

    if (allow_default_fallback && colour == -1)
    {
        colour = fallback_colour;
        if (colour == -1)
        {
            colour = CDISPLIB_DEFAULT_FONT_BG;
        }
    }

    while ((colour & 0xFF) == 0x11)
    {
        entry = colour >> 8;
        if (entry < 0 || entry >= display->private_palette.count)
        {
            colour = fallback_colour;
            if (allow_default_fallback && colour == -1)
            {
                colour = CDISPLIB_DEFAULT_FONT_BG;
            }
            continue;
        }

        colour = display->private_palette.entries[entry];
    }

    if ((colour & 0xFF) != 0x10)
    {
        entry = colour & 0xFF;
        if (entry < 0 || entry >= 16)
        {
            entry = fallback_colour & 0xFF;
            if (entry < 0 || entry >= 16)
            {
                entry = 0;
            }
        }
        colour = cdisplib_global_palette[entry];
    }

    return colour;
}

/*******************************************************************
 Function:      cdisplib_set_font_colours
 Description:   Select the colours for font output
 Parameters:    display = display supplying font state
                background = background colour
                foreground = foreground colour
 Returns:       none
 ******************************************************************/
void cdisplib_set_font_colours(const CDispDisplay *display, int background, int foreground)
{
    int resolved_bg;
    int resolved_fg;

    if (display == NULL)
    {
        return;
    }

    if (display->font_metrics.name == NULL)
    {
        cdisplib_set_colour(display, foreground);
        return;
    }

    resolved_bg = cdisplib_resolve_font_palette_entry(display,
                                                      background,
                                                      display->default_background,
                                                      1);
    resolved_fg = cdisplib_resolve_font_palette_entry(display,
                                                      foreground,
                                                      display->default_foreground,
                                                      0);

    _swix(ColourTrans_SetFontColours,
          _IN(0) | _IN(1) | _IN(2) | _IN(3),
          display->font_metrics.handle,
          resolved_bg,
          resolved_fg,
          14);
}

/*******************************************************************
 Function:      cdisplib_set_invert_colour
 Description:   Select the selection-invert colour
 Parameters:    none
 Returns:       none
 ******************************************************************/
void cdisplib_set_invert_colour(void)
{
    int colours;

    colours = 0;
    _swix(OS_ReadModeVariable, _IN(0) | _IN(1) | _OUT(2), -1, 3, &colours);
    if (colours < 16 && colours != -1)
    {
        _swix(Wimp_SetColour, _IN(0), 7 + (3 << 4));
    }
    else
    {
        _swix(ColourTrans_SetGCOL, _IN(0) | _IN(3) | _IN(4), -256, 0, 3);
    }
}
