}

int cdisplib_selftest_run(void)
{
    CDispDisplay *display;

    failures = 0;
    printf("Running CDispLib self-test\n");
    selftest_expect_true(strcmp(cdisplib_version(), Module_FullVersionAndDate) == 0,
                         "version string should match VersionNum");

    display = cdisplib_display_new("Self test");
    if (display == NULL)
    {
        selftest_fail("display allocation failed");
    }
    else
    {
        selftest_check_menu_construction();
        selftest_check_menu_warning_target();
        selftest_check_metadata(display);
        selftest_build_sample(display);
        selftest_expect_int(cdisplib_display_lines(display), 3, "sample should create three lines");
        selftest_check_line_navigation(display);
        selftest_check_text_accessors(display);
        selftest_check_selection(display);
        selftest_check_render(display);
        selftest_check_clipboard_messages(display);
        selftest_check_release_entity_message();
        selftest_check_clipboard_datasave_message();
        selftest_check_font_palette_resolution(display);
        selftest_check_reopen_bottom_adjust();
        selftest_check_resize_adjust();
        selftest_check_fullsize_adjust();
        selftest_check_recreated_window_info();
        selftest_check_selection_drag_parent_box();
        selftest_check_selection_extend_choice();
        selftest_check_file_output(display);
        selftest_check_mutation(display);
        selftest_check_menu_choices(display);
        cdisplib_display_kill(&display);
    }

    if (failures == 0)
    {
        printf("PASS: all self-tests succeeded\n");
        return 1;
    }

    printf("FAIL: %d self-test(s) failed\n", failures);
    return 0;
}
