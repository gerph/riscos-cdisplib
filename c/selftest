static void selftest_check_menu_choices(CDispDisplay *display)
{
    const char *font_name;
    int size_points;
    int select_all_choice[2];
    int clear_selection_choice[2];
    int clear_choice[2];
    int size_choice[3];
    int system_font_choice[3];

    select_all_choice[0] = 2;
    select_all_choice[1] = -1;
    clear_selection_choice[0] = 3;
    clear_selection_choice[1] = -1;
    clear_choice[0] = 0;
    clear_choice[1] = -1;
    size_choice[0] = 1;
    size_choice[1] = 6;
    size_choice[2] = -1;
    system_font_choice[0] = 0;
    system_font_choice[1] = 0;
    system_font_choice[2] = -1;

    cdisplib_display_add(display, "menu test");
    cdisplib_display_edit_menu_choice(display, select_all_choice);
    selftest_expect_true(cdisplib_display_has_selection(display), "edit menu select-all should activate selection");

    cdisplib_display_edit_menu_choice(display, clear_selection_choice);
    selftest_expect_true(!cdisplib_display_has_selection(display), "edit menu clear-selection should clear selection");

    cdisplib_display_menu_choice(display, size_choice);
    cdisplib_display_get_font(display, &font_name, &size_points);
    selftest_expect_int(size_points,
                        18,
                        "display menu size choice should preserve size when using system font");

    cdisplib_display_menu_choice(display, system_font_choice);
    cdisplib_display_get_font(display, &font_name, &size_points);
    selftest_expect_true(font_name == NULL || *font_name == '\0', "display menu system font choice should clear font name");

    cdisplib_display_edit_menu_choice(display, clear_choice);
    selftest_expect_int(cdisplib_display_lines(display), 0, "edit menu clear should empty the display");
}

static void selftest_check_menu_construction(void)
{
    const char *extras[2];
    wimp_menustr *menu;
    wimp_menustr *menu_from_append;
    wimp_menuitem *items;

    extras[0] = "Extra one";
    extras[1] = "Extra two";
    menu = cdisplib_display_menu_with_extras(extras, 2);
    selftest_expect_true(menu != NULL, "display menu with extras should be created");
    selftest_expect_int(cdisplib_display_menu_extra_base(), 2, "extra menu base should follow built-ins");

    if (menu != NULL)
    {
        items = (wimp_menuitem *) (menu + 1);
        selftest_expect_true(items[2].data.indirecttext.buffer != NULL, "first extra menu label should exist");
        selftest_expect_true(items[3].data.indirecttext.buffer != NULL, "second extra menu label should exist");
        selftest_expect_true(strcmp(items[2].data.indirecttext.buffer, "Extra one") == 0, "first extra menu label text");
        selftest_expect_true(strcmp(items[3].data.indirecttext.buffer, "Extra two") == 0, "second extra menu label text");
    }

    menu_from_append = cdisplib_display_menu_with_append("|Extra one|Extra two]D");
    selftest_expect_true(menu_from_append != NULL, "display menu with BASIC-style append should be created");
    if (menu_from_append != NULL)
    {
        items = (wimp_menuitem *) (menu_from_append + 1);
        selftest_expect_true(strcmp(items[2].data.indirecttext.buffer, "Extra one") == 0,
                             "first BASIC-style extra label text");
        selftest_expect_true(strcmp(items[3].data.indirecttext.buffer, "Extra two") == 0,
                             "second BASIC-style extra label text");
    }
}

static void selftest_check_menu_warning_target(void)
{
    int selection[3];

    selftest_expect_int(cdisplib_display_menu_warning_target(NULL),
                        cdisplib_menu_warning_none,
                        "NULL warning path should not open a submenu");

    selection[0] = -1;
    selection[1] = -1;
    selftest_expect_int(cdisplib_display_menu_warning_target(selection),
                        cdisplib_menu_warning_display,
                        "top-level menu warning should reopen the display menu");

    selection[0] = 0;
    selection[1] = -1;
    selftest_expect_int(cdisplib_display_menu_warning_target(selection),
                        cdisplib_menu_warning_font,
                        "font menu warning should target the font submenu");

    selection[0] = 1;
    selection[1] = -1;
    selftest_expect_int(cdisplib_display_menu_warning_target(selection),
                        cdisplib_menu_warning_size,
                        "size menu warning should target the size submenu");

    selection[0] = 2;
    selection[1] = -1;
    selftest_expect_int(cdisplib_display_menu_warning_target(selection),
                        cdisplib_menu_warning_none,
                        "extra-item warning should not open a built-in submenu");
}

static void selftest_check_metadata(CDispDisplay *display)
{
    const char *font_name;
    int size_points;
    int old_line_height;
    int old_max_char_width;
    CDispLine *line;
    int x;

    cdisplib_display_colours(display, 3, 1);
    cdisplib_display_size(display, 10, 8);
    cdisplib_display_set_private_word(display, 12345);
    cdisplib_display_set_font(display, "", -1);
    cdisplib_display_get_font(display, &font_name, &size_points);

    selftest_expect_int(cdisplib_display_get_private_word(display), 12345, "private word round-trip");
    selftest_expect_true(font_name == NULL || *font_name == '\0', "system font should report empty name");
    selftest_expect_int(size_points, 12, "default size should remain 12 points");

    cdisplib_display_set_font(display, "Homerton.Medium", 18);
    cdisplib_display_get_font(display, &font_name, &size_points);
    selftest_expect_int(size_points, 18, "named font should update point size");
    old_line_height = display->font_metrics.line_height;
    old_max_char_width = display->font_metrics.max_char_width;

    cdisplib_display_set_font(display, "NoSuch.Font.Name", -1);
    selftest_expect_int(display->font_metrics.handle,
                        -1,
                        "invalid font should leave no live font handle");
    selftest_expect_int(display->font_metrics.line_height,
                        old_line_height,
                        "invalid font should preserve the previous cached line height");
    selftest_expect_int(display->font_metrics.max_char_width,
                        old_max_char_width,
                        "invalid font should preserve the previous cached max character width");
    selftest_expect_int(cdisplib_measure_text(display, "abc"),
                        1,
                        "invalid named font should collapse measured run width to one OS unit");
    cdisplib_display_add(display, "probe");
    line = cdisplib_display_line_handle(display, 0);
    selftest_expect_true(line != NULL, "metadata test should have a line to probe after invalid font selection");
    if (line != NULL)
    {
        x = 4;
        selftest_expect_string_owned(cdisplib_display_line_from(display, line, &x),
                                     "probe",
                                     "metadata test should probe the expected line text");
    }
    cdisplib_display_clear(display);

    cdisplib_display_set_font(display, "", 24);
    cdisplib_display_get_font(display, &font_name, &size_points);
    selftest_expect_true(font_name == NULL || *font_name == '\0',
                         "switching back to system font should clear font name");
    selftest_expect_int(size_points,
                        18,
                        "switching to system font should preserve previous point size");
}

static void selftest_check_render(CDispDisplay *display)
{
    CDispRenderBox clip;
    int work_left;
    int work_top;

    work_left = 64;
    work_top = 512;
    clip.x0 = work_left;
    clip.y0 = work_top - (cdisplib_display_lines(display) * 36) - 32;
    clip.x1 = work_left + 1024;
    clip.y1 = work_top + 16;

    cdisplib_display_selection_clear(display);
    selftest_expect_true(!cdisplib_display_has_selection(display),
                         "render test should start without a selection");

    cdisplib_display_render(display, work_left, work_top, &clip);

    cdisplib_display_select_range(display, 0, 1, 1, 3);
    selftest_expect_true(cdisplib_display_has_selection(display),
                         "programmatic selection should activate highlighting");

    cdisplib_display_render(display, work_left, work_top, &clip);

    cdisplib_display_select_all(display);
    selftest_expect_true(cdisplib_display_has_selection(display),
                         "select_all should keep a programmatic selection active for rendering");

    cdisplib_display_render(display, work_left, work_top, &clip);
}

static void selftest_check_clipboard_messages(CDispDisplay *display)
{
    wimp_msgstr message;

    (void) display;
    cdisplib_set_task_handle(99);
    free(cdisplib_global_clipboard);
    cdisplib_global_clipboard = cdisplib_strdup("alpha");
    cdisplib_global_clipboard_size = 5;
    selftest_expect_true(cdisplib_global_clipboard != NULL,
                         "clipboard buffer should be populated for message tests");

    memset(&message, 0, sizeof(message));
    message.hdr.action = wimp_MCLAIMENTITY;
    message.hdr.task = 99;
    message.data.claimentity.flags = wimp_CECLIPBOARD;
    selftest_expect_true(!cdisplib_display_clipboard_message(&message),
                         "ClaimEntity from the current task should be ignored");
    selftest_expect_true(cdisplib_global_clipboard != NULL,
                         "self ClaimEntity should not release the clipboard");

    message.hdr.task = 100;
    selftest_expect_true(cdisplib_display_clipboard_message(&message),
                         "ClaimEntity from another task should release the clipboard");
    selftest_expect_true(cdisplib_global_clipboard == NULL,
                         "foreign ClaimEntity should clear the clipboard");

    free(cdisplib_global_clipboard);
    cdisplib_global_clipboard = cdisplib_strdup("alpha");
    cdisplib_global_clipboard_size = 5;
    cdisplib_global_clipboard_save_ref = 321;
    selftest_expect_true(cdisplib_global_clipboard != NULL,
                         "clipboard buffer should be repopulated for DataSaveAck");

    selftest_expect_true(cdisplib_save_clipboard_file(SELFTEST_CLIP_FILE),
                         "clipboard save helper should write the clipboard file");
    selftest_expect_file(SELFTEST_CLIP_FILE,
                         "alpha",
