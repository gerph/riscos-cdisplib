static void selftest_check_font_palette_resolution(CDispDisplay *display)
{
    int resolved;

    display->default_background = -1;
    display->default_foreground = 7;
    cdisplib_global_palette[3] = 0x03030310;
    cdisplib_global_palette[7] = 0x07070710;
    selftest_expect_int(cdisplib_global_palette[7],
                        0x07070710,
                        "self-test setup should seed the cached Wimp palette");
    cdisplib_display_set_palette(display, 0, 3);
    cdisplib_display_set_palette(display, 1, (0 << 8) | 0x11);

    resolved = cdisplib_resolve_font_palette_entry(display,
                                                   (1 << 8) | 0x11,
                                                   display->default_background,
                                                   1);
    selftest_expect_int(resolved,
                        0x03030310,
                        "font background should resolve chained private palette entries");

    resolved = cdisplib_resolve_font_palette_entry(display,
                                                   (99 << 8) | 0x11,
                                                   display->default_foreground,
                                                   0);
    selftest_expect_int(resolved,
                        0x07070710,
                        "font foreground should fall back to the default foreground when private palette resolution fails");

    resolved = cdisplib_resolve_font_palette_entry(display,
                                                   -1,
                                                   display->default_background,
                                                   1);
    selftest_expect_int(resolved,
                        0xDDDDDD10,
                        "font background should use the default mottled fallback when no background is defined");
}

static void selftest_check_reopen_bottom_adjust(void)
{
    wimp_openstr current_open;
    wimp_wind current_info;
    wimp_openstr requested_open;

    memset(&current_open, 0, sizeof(current_open));
    memset(&current_info, 0, sizeof(current_info));
    memset(&requested_open, 0, sizeof(requested_open));

    current_open.box.y0 = 600;
    current_open.box.y1 = 900;
    current_open.y = -100;
    current_info.ex.y0 = -400;
    current_info.ex.y1 = 0;

    requested_open = current_open;
    requested_open.box.y0 = 500;
    requested_open.box.y1 = 900;
    requested_open.y = current_open.y;

    cdisplib_adjust_reopen_for_bottom(&current_open, &current_info, &requested_open);
    selftest_expect_int(requested_open.y,
                        0,
                        "reopen should keep the window bottom aligned when already at bottom");

    requested_open = current_open;
    requested_open.box.y0 = 500;
    requested_open.box.y1 = 900;
    requested_open.y = current_open.y - 16;

    cdisplib_adjust_reopen_for_bottom(&current_open, &current_info, &requested_open);
    selftest_expect_int(requested_open.y,
                        current_open.y - 16,
                        "reopen should not force bottom when the request changes scroll position");

    current_open.y = -80;
    requested_open = current_open;
    requested_open.box.y0 = 500;
    requested_open.box.y1 = 900;

    cdisplib_adjust_reopen_for_bottom(&current_open, &current_info, &requested_open);
    selftest_expect_int(requested_open.y,
                        -80,
                        "reopen should not force bottom when the old view was not at the bottom");
}

static void selftest_check_resize_adjust(void)
{
    CDispDisplay display;
    wimp_openstr current_open;
    wimp_wind current_info;
    wimp_box new_extent;
    wimp_openstr adjusted_open;
    int moved;

    memset(&display, 0, sizeof(display));
    memset(&current_open, 0, sizeof(current_open));
    memset(&current_info, 0, sizeof(current_info));
    memset(&new_extent, 0, sizeof(new_extent));
    memset(&adjusted_open, 0, sizeof(adjusted_open));

    display.line_count = 20;
    display.natural_height_lines = 12;
    display.font_metrics.line_height = 36;

    current_open.box.x0 = 10;
    current_open.box.x1 = 210;
    current_open.box.y0 = 300;
    current_open.box.y1 = 700;
    current_open.y = -200;
    current_info.ex.x0 = 0;
    current_info.ex.x1 = 180;
    current_info.ex.y0 = -600;
    current_info.ex.y1 = 0;

    new_extent.x0 = 0;
    new_extent.x1 = 260;
    new_extent.y0 = -728;
    new_extent.y1 = 0;

    cdisplib_adjust_resize_open(&display,
                                1,
                                &current_open,
                                &current_info,
                                &new_extent,
                                &adjusted_open,
                                &moved);
    selftest_expect_int(adjusted_open.box.x1,
                        270,
                        "resize should grow a full-width window to the new extent width");
    selftest_expect_int(adjusted_open.y,
                        -328,
                        "resize should keep a bottom-aligned view at the bottom");
    selftest_expect_true(moved != 0,
                         "resize should report a move when a full-width view tracks the new extent");

    current_open.box.x0 = 10;
    current_open.box.x1 = 110;
    current_open.box.y0 = 500;
    current_open.box.y1 = 700;
    current_open.y = -120;
    current_info.ex.x1 = 260;
    current_info.ex.y0 = -728;
    moved = 0;

    cdisplib_adjust_resize_open(&display,
                                1,
                                &current_open,
                                &current_info,
                                &new_extent,
                                &adjusted_open,
                                &moved);
    selftest_expect_int(adjusted_open.box.x1,
                        110,
                        "resize should not widen a non-full-width window");
    selftest_expect_int(adjusted_open.y,
                        -120,
                        "resize should not force bottom when the view was not at the bottom");
    selftest_expect_int(moved,
                        0,
                        "resize should not report movement for an unchanged partial view");
}

static void selftest_check_fullsize_adjust(void)
{
    CDispDisplay display;
    wimp_openstr current_open;
    wimp_openstr adjusted_open;

    memset(&display, 0, sizeof(display));
    memset(&current_open, 0, sizeof(current_open));
    memset(&adjusted_open, 0, sizeof(adjusted_open));

    display.line_count = 3;
    display.widest_width = 120;
    display.font_metrics.line_height = 36;

    current_open.box.x0 = 64;
    current_open.box.y0 = 300;
    current_open.box.x1 = 164;
    current_open.box.y1 = 500;

    cdisplib_adjust_fullsize_open(&display, &current_open, &adjusted_open);
    selftest_expect_int(adjusted_open.box.x0,
                        64,
                        "fullsize should preserve the left edge");
    selftest_expect_int(adjusted_open.box.x1,
                        64 + 120 + 12,
                        "fullsize should widen to the display content width");
    selftest_expect_int(adjusted_open.box.y1,
                        500,
                        "fullsize should preserve the top edge");
    selftest_expect_int(adjusted_open.box.y0,
                        500 - (3 * 36) - CDISPLIB_WINDOW_BOTTOM_MARGIN,
                        "fullsize should grow to the full content height");
}

static void selftest_check_recreated_window_info(void)
{
    wimp_wind current_info;
    wimp_wind recreated_info;
    char old_title[16];

    memset(&current_info, 0, sizeof(current_info));
    memset(&recreated_info, 0, sizeof(recreated_info));
    strcpy(old_title, "Old");

    current_info.box.x0 = 10;
    current_info.box.y0 = 20;
    current_info.box.x1 = 300;
    current_info.box.y1 = 400;
    current_info.scx = 7;
    current_info.scy = -33;
    current_info.behind = -1;
    current_info.flags = (wimp_wflags) (wimp_WNEW | wimp_WTITLE | wimp_WSIZE);
    current_info.ex.x0 = 1;
    current_info.ex.y0 = -600;
    current_info.ex.x1 = 250;
    current_info.ex.y1 = 2;
    current_info.titleflags = (wimp_iconflags) 0x13D;
    current_info.workflags = (wimp_iconflags) 0xA000;
    current_info.minsize = 12345;
    current_info.title.indirecttext.buffer = old_title;
    current_info.title.indirecttext.validstring = old_title;
    current_info.title.indirecttext.bufflen = 16;
    current_info.nicons = 0;

    cdisplib_prepare_recreated_window(&current_info, "New title", &recreated_info);
    selftest_expect_int(recreated_info.box.x0,
                        10,
                        "recreated window should preserve the old visible box");
    selftest_expect_int(recreated_info.ex.y0,
                        -600,
                        "recreated window should preserve the old extent");
    selftest_expect_int(recreated_info.minsize,
                        12345,
                        "recreated window should preserve the old minimum size");
    selftest_expect_true(recreated_info.title.indirecttext.buffer != NULL,
                         "recreated window should provide a title buffer");
    selftest_expect_true(strcmp(recreated_info.title.indirecttext.buffer, "New title") == 0,
                         "recreated window should use the new title text");
    selftest_expect_true(recreated_info.title.indirecttext.validstring == NULL,
                         "recreated window should clear the title validation string");
    selftest_expect_int(recreated_info.title.indirecttext.bufflen,
                        9,
                        "recreated window should refresh the title buffer length");
}

static void selftest_check_selection_drag_parent_box(void)
{
    wimp_openstr open;
    wimp_wind info;
    wimp_box parent;

    memset(&open, 0, sizeof(open));
    memset(&info, 0, sizeof(info));
    memset(&parent, 0, sizeof(parent));

    open.box.x0 = 100;
    open.box.x1 = 300;
    open.box.y0 = 200;
    open.box.y1 = 500;
    info.ex.x0 = 0;
    info.ex.x1 = 150;
    info.ex.y0 = 0;
    info.ex.y1 = 250;

    cdisplib_selection_drag_parent_box(1, &open, &info, &parent);
    selftest_expect_int(parent.x0, 100, "autoscroll drag parent should use the visible x0");
    selftest_expect_int(parent.y1, 500, "autoscroll drag parent should use the visible y1");

    info.ex.x1 = 400;
    info.ex.y1 = 700;
    cdisplib_selection_drag_parent_box(0, &open, &info, &parent);
    selftest_expect_int(parent.x0,
                        -CDISPLIB_SELECTION_SCREEN_LIMIT,
                        "partial-width drag parent should allow free horizontal movement");
    selftest_expect_int(parent.y0,
                        -CDISPLIB_SELECTION_SCREEN_LIMIT,
                        "partial-height drag parent should allow free vertical movement");

    info.ex.x1 = 200;
    info.ex.y1 = 300;
    cdisplib_selection_drag_parent_box(0, &open, &info, &parent);
    selftest_expect_int(parent.x0, 100, "full-width drag parent should clamp x0 to the visible box");
    selftest_expect_int(parent.y0, 200, "full-height drag parent should clamp y0 to the visible box");
}

static void selftest_check_selection_extend_choice(void)
{
    CDispSelectionPoint point;
    CDispSelectionPoint anchor;
    CDispSelectionPoint focus;

    anchor.line = 2;
    anchor.column = 10;
    focus.line = 4;
    focus.column = 2;
    point.line = 3;
