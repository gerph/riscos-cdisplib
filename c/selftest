static int failures;

static void selftest_fail(const char *message)
{
    printf("FAIL: %s\n", message);
    failures += 1;
}

static void selftest_expect_true(int condition, const char *message)
{
    if (!condition)
    {
        selftest_fail(message);
    }
}

static void selftest_expect_int(int actual, int expected, const char *message)
{
    if (actual != expected)
    {
        printf("FAIL: %s (got %d expected %d)\n", message, actual, expected);
        failures += 1;
    }
}

static void selftest_expect_string_owned(char *actual, const char *expected, const char *message)
{
    if (actual == NULL)
    {
        selftest_fail(message);
        return;
    }

    if (strcmp(actual, expected) != 0)
    {
        printf("FAIL: %s (got '%s' expected '%s')\n", message, actual, expected);
        failures += 1;
    }
    free(actual);
}

static char *selftest_read_file(const char *filename)
{
    FILE *in;
    long size;
    char *buffer;
    size_t got;

    in = fopen(filename, "r");
    if (in == NULL)
    {
        return NULL;
    }

    if (fseek(in, 0, SEEK_END) != 0)
    {
        fclose(in);
        return NULL;
    }
    size = ftell(in);
    if (size < 0 || fseek(in, 0, SEEK_SET) != 0)
    {
        fclose(in);
        return NULL;
    }

    buffer = malloc((size_t) size + 1);
    if (buffer == NULL)
    {
        fclose(in);
        return NULL;
    }

    got = fread(buffer, 1, (size_t) size, in);
    fclose(in);
    buffer[got] = '\0';
    return buffer;
}

static void selftest_expect_file(const char *filename, const char *expected, const char *message)
{
    char *actual;

    actual = selftest_read_file(filename);
    if (actual == NULL)
    {
        selftest_fail(message);
        return;
    }

    if (strcmp(actual, expected) != 0)
    {
        printf("FAIL: %s (got '%s' expected '%s')\n", message, actual, expected);
        failures += 1;
    }
    free(actual);
}

static int selftest_read_filetype(const char *filename)
{
    _kernel_osfile_block block;
    int object_type;

    memset(&block, 0, sizeof(block));
    object_type = _kernel_osfile(17, filename, &block);
    if (object_type <= 0)
    {
        return -1;
    }

    if ((block.load & 0xFFF00000) != 0xFFF00000)
    {
        return -1;
    }

    return (block.load >> 8) & 0xFFF;
}

static void selftest_remove_file(const char *filename)
{
    remove(filename);
}

static void selftest_build_sample(CDispDisplay *display)
{
    CDispLine *first;

    cdisplib_display_add(display, "alpha");
    cdisplib_display_add(display, "gamma");
    first = cdisplib_display_line_handle(display, 0);
    cdisplib_display_add_at(display, first, "beta");
    cdisplib_display_add_to_at(display, first, " one", -1, -1);
    cdisplib_display_add_to(display, " tail", -1, -1);
}

static void selftest_check_line_navigation(CDispDisplay *display)
{
    CDispLine *line0;
    CDispLine *line1;
    CDispLine *line2;

    line0 = cdisplib_display_line_handle(display, 0);
    line1 = cdisplib_display_line_handle(display, 1);
    line2 = cdisplib_display_line_handle(display, 2);

    selftest_expect_true(line0 != NULL, "line 0 should exist");
    selftest_expect_true(line1 != NULL, "line 1 should exist");
    selftest_expect_true(line2 != NULL, "line 2 should exist");
    selftest_expect_true(cdisplib_display_line_handle(display, -1) == line2,
                         "line_handle(-1) should return the last line");
    selftest_expect_true(cdisplib_display_line_handle(display, 3) == line2,
                         "line_handle(line_count) should return the last line");
    selftest_expect_true(cdisplib_display_line_handle(display, 99) == line2,
                         "line_handle(past line_count) should return the last line");
    selftest_expect_true(cdisplib_display_next_line(line0) == line1, "line 0 next should be line 1");
    selftest_expect_true(cdisplib_display_prev_line(line2) == line1, "line 2 previous should be line 1");
    selftest_expect_int(cdisplib_display_line_number_from_handle(display, line2), 2, "line number from handle");
    selftest_expect_true(cdisplib_display_line_from_y(display, 0) == NULL,
                         "line_from_y should return NULL above the first line");
    selftest_expect_true(cdisplib_display_line_from_y(display, -200) == NULL,
                         "line_from_y should return NULL below the last line");
}

static void selftest_check_text_accessors(CDispDisplay *display)
{
    CDispLine *line0;
    CDispLine *line2;
    CDispDisplay *word_display;
    CDispLine *word_line;
    int x;
    int column;
    int bg;
    int fg;
    char *word;

    line0 = cdisplib_display_line_handle(display, 0);
    line2 = cdisplib_display_line_handle(display, 2);

    x = 4;
    selftest_expect_string_owned(cdisplib_display_line_from(display, line0, &x),
                                 "alpha",
                                 "line_from should return the remainder of the current run");
    selftest_expect_int(x,
                        4 + (5 * 16),
                        "line_from should advance x to the end of the current run");

    x = 4 + (3 * 16);
    selftest_expect_string_owned(cdisplib_display_line_to(display, line0, &x),
                                 "alp",
                                 "line_to should return a substring within the current run");
    selftest_expect_int(x,
                        4 + (5 * 16),
                        "line_to should advance x to the end of the current run");

    column = 6;
    selftest_expect_string_owned(cdisplib_display_line_from_char(display, line0, &column),
                                 "one",
                                 "line_from_char should return the remainder of the current run");
    selftest_expect_int(column,
                        9,
                        "line_from_char should advance to the end of the current run");

    x = 4 + (6 * 16);
    bg = 1234;
    fg = 1234;
    selftest_expect_string_owned(cdisplib_display_line_from_start(display, line0, &x, &bg, &fg),
                                 " one",
                                 "line_from_start should return the run covering x");
    selftest_expect_int(bg, -1, "line_from_start background should be default");
    selftest_expect_int(fg, -1, "line_from_start foreground should be default");

    x = 4 + (64 * 16);
    selftest_expect_string_owned(cdisplib_display_line_from_start(display, line0, &x, &bg, &fg),
                                 "",
                                 "line_from_start should return empty past the end of the line");
    selftest_expect_int(x,
                        4 + (64 * 16) + 4,
                        "line_from_start should still advance x by four when no run is found");

    selftest_expect_string_owned(cdisplib_display_word_at(display, line0, 4 + (7 * 16)),
                                 "one",
                                 "word_at should identify the word at x");

    selftest_expect_int(cdisplib_display_x_to_column(display, line0, 4 + (7 * 16)),
                        7,
                        "x_to_column should convert x into a character index");
    selftest_expect_int(cdisplib_display_column_to_x(display, line0, 7),
                        4 + (7 * 16),
                        "column_to_x should convert a character index into x");

    x = 4;
    selftest_expect_string_owned(cdisplib_display_line_from(display, line2, &x),
                                 "gamma",
                                 "line_from should stop at the end of the current run");

    word_display = cdisplib_display_new("word test");
    selftest_expect_true(word_display != NULL, "word test display should be created");
    if (word_display != NULL)
    {
        cdisplib_display_add(word_display, "left");
        cdisplib_display_add_to(word_display, "right", -1, -1);
        word_line = cdisplib_display_line_handle(word_display, 0);
        word = cdisplib_display_word_at(word_display, word_line, 4 + (5 * 16));
        selftest_expect_string_owned(word,
                                     "right",
                                     "word_at should not cross a text-run boundary");
        cdisplib_display_kill(&word_display);
    }
}

static void selftest_check_selection(CDispDisplay *display)
{
    CDispLine *line;
    int line_number;
    int column;
    char *part;

    cdisplib_display_select_range(display, 0, 1, 1, 3);
    selftest_expect_true(cdisplib_display_has_selection(display), "selection should be active");

    line = NULL;
    line_number = 0;
    column = 0;

    part = cdisplib_display_read_selection(display, &line, &line_number, &column);
    selftest_expect_string_owned(part, "lpha", "first selection fragment");

    part = cdisplib_display_read_selection(display, &line, &line_number, &column);
    selftest_expect_string_owned(part, " one", "second selection fragment should continue the same line");

    part = cdisplib_display_read_selection(display, &line, &line_number, &column);
    selftest_expect_string_owned(part, "", "selection line break marker");

    part = cdisplib_display_read_selection(display, &line, &line_number, &column);
    selftest_expect_string_owned(part, "bet", "final selection fragment");

    part = cdisplib_display_read_selection(display, &line, &line_number, &column);
    selftest_expect_string_owned(part, "", "selection should terminate with a final empty fragment");
    selftest_expect_true(line == NULL, "selection iterator should finish after the terminating empty fragment");

    cdisplib_display_selection_clear(display);
    selftest_expect_true(!cdisplib_display_has_selection(display), "selection should clear");

    cdisplib_display_select_all(display);
    selftest_expect_true(cdisplib_display_has_selection(display), "select_all should activate selection");

    cdisplib_display_selection_clear(display);
    cdisplib_display_selection_start(display, 0, 0, 1, 0);
    cdisplib_display_selection_modify(display,
                                      4 + (7 * 16),
                                      -display->font_metrics.line_height * (display->line_count + 1));
    selftest_expect_int(display->selection.focus.line,
                        display->line_count,
                        "below-bottom selection should keep the focus line at EOF");
    selftest_expect_int(display->selection.focus.column,
                        7,
                        "below-bottom selection should resolve the EOF column from the last line");
    line = NULL;
    line_number = 0;
    column = 0;

    part = cdisplib_display_read_selection(display, &line, &line_number, &column);
    selftest_expect_string_owned(part, "alpha", "below-bottom selection should start with the first run");

    part = cdisplib_display_read_selection(display, &line, &line_number, &column);
    selftest_expect_string_owned(part, " one", "below-bottom selection should continue the first line");

    part = cdisplib_display_read_selection(display, &line, &line_number, &column);
    selftest_expect_string_owned(part, "", "below-bottom selection should emit a line break after line 0");

    part = cdisplib_display_read_selection(display, &line, &line_number, &column);
    selftest_expect_string_owned(part, "beta", "below-bottom selection should include the middle line");

    part = cdisplib_display_read_selection(display, &line, &line_number, &column);
    selftest_expect_string_owned(part, "", "below-bottom selection should emit a line break after line 1");

    part = cdisplib_display_read_selection(display, &line, &line_number, &column);
    selftest_expect_string_owned(part, "gamma", "below-bottom selection should include the first run of the last line");

    part = cdisplib_display_read_selection(display, &line, &line_number, &column);
    selftest_expect_string_owned(part, " tail", "below-bottom selection should still include the full last line in iteration");

    part = cdisplib_display_read_selection(display, &line, &line_number, &column);
    selftest_expect_string_owned(part, "", "below-bottom selection should terminate with an empty fragment");
    selftest_expect_true(line == NULL, "below-bottom selection iterator should finish cleanly");
}

